# bbangmoa-server 환경변수 목록  ── 값은 절대 여기 적지 않는다. 이름과 설명만.
#
# 이 파일의 정체
#   배포 워크플로는 서버의 .env 를 만들지 않는다. TAG= 한 줄만 갈아끼우고
#   나머지는 손대지 않는다(.github/workflows/deploy.yml 참고).
#   즉 서버의 .env 는 사람이 관리하는 파일이고, 어디에도 백업이 없다.
#   → 이 파일이 그 "무엇이 들어가야 하는가"의 유일한 기록이다.
#     서버를 새로 만들면 이 목록대로 다시 채우면 된다.
#
# 값이 사는 자리는 셋 (헷갈리기 쉬움)
#   1) 이 레포의 .env            → 내 노트북에서 docker compose 로 띄울 때
#   2) EC2 의 ~/app/bbangmoa/.env → 실제 운영 컨테이너가 읽는 값
#   3) GitHub Secrets            → SSH 접속 정보만. API 키는 여기 안 넣는다
#
# 주의: compose 의 .env 는 docker-compose.yml 안의 ${} 를 치환할 뿐,
#      컨테이너로 자동 전달되지 않는다. 새 변수를 추가할 때는
#      docker-compose.yml 의 api.environment 에도 반드시 한 줄 적어야 한다.

# ── 외부 API 키 ───────────────────────────────────────────────
# 프론트 .env 의 VITE_ 접두사만 뗀 같은 값이다.
# 이 키들을 서버로 옮기는 게 목적이다 — 브라우저 번들에서 사라진다.

# 한국관광공사 KorService2 (일반 인증키 Decoding). 쿼리 파라미터로 붙는다.
TOUR_API_KEY=

# 카카오 REST 키. 로컬 검색과 모빌리티 길찾기가 같은 키를 공유한다.
#  헤더로 붙는다: Authorization: KakaoAK {키}
KAKAO_REST_KEY=

# ODSAY 대중교통. 쿼리 파라미터로 붙는다.
#  ⚠ Referer 로 등록 도메인을 검사한다. 서버에서 부르면 Referer 가 없어
#    ApiKeyAuthFailed 가 나므로, application.yaml 에서 고정 Referer 를 붙인다.
#    ODSAY 대시보드에 등록된 주소가 바뀌면 그 설정도 같이 바꿔야 한다.
ODSAY_API_KEY=

# TMAP 보행자 경로. 헤더 appKey 로 붙는다(접두사 없음).
TMAP_APP_KEY=

# ── DB ────────────────────────────────────────────────────────
# 로컬은 비워도 된다(compose 기본값 bbangmoa / bbangmoa / localdev).
# 운영 서버에서는 반드시 채운다.
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# ── 프론트 허용 출처 ──────────────────────────────────────────
# 콤마로 여러 개. 운영 서버에만 넣는다.
#  예) https://breadmoa.com,https://bbangmoa.vercel.app
CORS_ALLOWED_ORIGINS=

# ── 실행 설정 ─────────────────────────────────────────────────
# 로컬 local / 운영 prod
SPRING_PROFILES_ACTIVE=

# 배포 워크플로가 자동으로 써넣는다. 사람이 건드릴 일은 롤백할 때뿐 —
# 이전 커밋 해시로 바꾸고 docker compose up -d 하면 그 버전으로 돌아간다.
TAG=
